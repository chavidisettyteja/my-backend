// Root Route
app.get("/", (req, res) => {
  res.send("API is running...");
});

// Admin Login Route
app.post("/admin/login", (req, res) => {
  const { username, password } = req.body;
  if (
    username === process.env.ADMIN_USERNAME &&
    password === process.env.ADMIN_PASSWORD
  ) {
    res.status(200).json({ message: "Login successful" });
  } else {
    res.status(401).json({ message: "Invalid credentials" });
  }
});

// File Upload Setup
const storage = multer.diskStorage({
  destination: (req, file, cb) => cb(null, "uploads/"),
  filename: (req, file, cb) =>
    cb(null, `${Date.now()}-${file.originalname}`),
});

const upload = multer({ storage });

/* ==================== PROJECT ROUTES ===================== */

// POST: Add a Project
app.post(
  "/admin/project",
  upload.fields([
    { name: "image", maxCount: 1 },
    { name: "bgimage", maxCount: 1 },
    { name: "brochure", maxCount: 1 },
  ]),
  async (req, res) => {
    try {
      const amenities = req.body.amenities
        ? JSON.parse(req.body.amenities)
        : {};

      const bhk = req.body.bhk
        ? JSON.parse(req.body.bhk)
        : {};

      // force boolean
      Object.keys(amenities).forEach(
        (k) => (amenities[k] = amenities[k] === true)
      );
      Object.keys(bhk).forEach(
        (k) => (bhk[k] = bhk[k] === true)
      );

      const project = new Project({
        name: req.body.name,
        type: req.body.type,
        possession: req.body.possession,
        status: req.body.status,
        location: req.body.location,

        priceRange: {
          min: req.body.minPrice ? Number(req.body.minPrice) : null,
          max: req.body.maxPrice ? Number(req.body.maxPrice) : null,
        },

        amenities,
        bhk,

        imageUrl: req.files?.image
          ? `/uploads/${req.files.image[0].filename}`
          : null,

        bgimageUrl: req.files?.bgimage
          ? `/uploads/${req.files.bgimage[0].filename}`
          : null,

        brochureUrl: req.files?.brochure
          ? `/uploads/${req.files.brochure[0].filename}`
          : null,
      });

      await project.save();
      res.status(201).json({ message: "Project saved", project });
    } catch (err) {
      console.error("❌ PROJECT SAVE ERROR:", err);
      res.status(500).json({ message: err.message });
    }
  }
);



